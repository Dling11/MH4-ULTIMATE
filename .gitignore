*.bndb

# ── Servers' own state (server/): a lobby's private key and names, a room's token ──
lobby-data/
server/docker/.env

# ── Python ─────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.pytest_cache/

# ── Agents' git worktrees ──────────────────────────────
.claude/worktrees/

# ── Editors / OS ───────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
# Private build cache, signing keys and imported emulator binaries
.local/
dist/
**/.gradle/
**/.cxx/
**/local.properties
**/*.jks
**/*.keystore

# Installable Android packages and signing sidecars stay local
*.apk
*.aab
*.apks
*.idsig
