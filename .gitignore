*.cci
*.cia
*.cxi
*.cfa
*.app
*.ncch
*.arc
code.bin
exheader.bin
romfs.bin
exefs.bin
*.sav

# ── Build output ───────────────────────────────────────
build/
export/
out/
*.elf
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# ── Disassembler projects (may embed game code) ────────
*.gpr
*.rep/
*.i64
