@@ -461,6 +466,20 @@
     if (new_surface_pending && !recreate_swapchain()) {
         DropFrame(frame);
         return;
+    }
+
+    // A speed change can need mailbox presentation even though the Android
+    // surface is unchanged. Reuse the live surface: the surface-change path
+    // waits for a replacement surface and must not be used for this.
+    const bool use_vsync = Settings::values.use_vsync.GetValue();
+    const auto limit = Settings::GetFrameLimit();
+    const bool accelerated = limit > 100 || limit == 0;
+    if (accelerated != accelerated_present || use_vsync != vsync_enabled) {
+        std::scoped_lock submit_lock{scheduler.submit_mutex};
+        graphics_queue.waitIdle();
+        swapchain.Create(frame->width, frame->height, surface, low_refresh_rate);
+        accelerated_present = accelerated;
+        vsync_enabled = use_vsync;
     }
